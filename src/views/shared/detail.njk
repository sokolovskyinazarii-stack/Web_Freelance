{% extends "layout.njk" %}
{% import "macros/table.njk" as table %}
{% import "macros/ui.njk" as ui %}
{% import "macros/icons.njk" as icons %}

{% block content %}
<div class="page">
  <aside class="rail">
    <nav class="crumbs" aria-label="Навігаційний ланцюжок">
      <a href="/{{ active }}">{{ label }}</a>
      <span>/</span>
      <span>{{ title }}</span>
    </nav>

    <div class="detail-identity" data-reveal>
      {{ ui.avatar(avatar) | safe }}
      <div>
        <h1>{{ title }}</h1>
        <p>{{ subtitle }}</p>
      </div>
    </div>

    {% if badge.type != 'rating' %}
      <div data-reveal>{{ ui.cell(badge) | safe }}</div>
    {% endif %}

    <div class="rail-actions rail-actions-stack" data-reveal>
      {% if canManage %}
        {% if passwordTarget %}
          <button class="btn btn-ghost" type="button" data-password data-resource="{{ passwordTarget.resource }}" data-id="{{ passwordTarget.id }}" data-user-name="{{ passwordTarget.name }}">
            {{ icons.icon('key', 15) }}
            Скинути пароль
          </button>
        {% endif %}
        <a class="btn btn-ghost" href="/{{ active }}/{{ id }}/edit">
          {{ icons.icon('edit', 15) }}
          Редагувати
        </a>
        <button class="btn btn-danger" type="button" data-delete data-resource="{{ active }}" data-id="{{ id }}" data-title="{{ title }}">
          {{ icons.icon('trash', 15) }}
          Видалити
        </button>
      {% endif %}
    </div>
  </aside>

  <div class="column">
    {% if flash %}
      <div class="alert alert-{{ flash.type }}" data-reveal>{{ flash.text }}</div>
    {% endif %}

    <section class="metric-grid">
      {% for metric in metrics %}
        <article class="metric-card" data-reveal>
          <span class="metric-label">{{ metric.label }}</span>
          <strong>{{ ui.cell(metric.cell) | safe }}</strong>
          {% if metric.hint %}<small>{{ metric.hint }}</small>{% endif %}
        </article>
      {% endfor %}
    </section>

    <section class="sheet">
      <header class="sheet-head" data-reveal>
        <h2 class="sheet-title">{{ icons.icon('orders', 17) }} Деталі</h2>
      </header>
      <dl class="field-grid">
        {% for field in fields %}
          <div class="field{% if field.wide %} field-wide{% endif %}">
            <dt>{{ field.label }}</dt>
            <dd>{{ ui.cell(field.cell) | safe }}</dd>
          </div>
        {% endfor %}
      </dl>
    </section>

    {% if ordersHidden %}
      <p class="detail-note">
        Замовлення за цим {{ 'проєктом' if active == 'projects' else 'фрілансером' }}
        доступні {% if currentUser %}лише учасникам і адміністратору{% else %}після входу{% endif %}.
        {% if not currentUser %}<a href="/login">Увійти</a>{% endif %}
      </p>
    {% endif %}

    {% if active == 'orders' and workflow %}
      {% include "partials/order-workflow.njk" %}
    {% endif %}

    {% if active == 'deliveries' and workflow %}
      {% include "partials/delivery-workflow.njk" %}
    {% endif %}

    {% for relation in relations %}
      {% if relation.table.rows.length %}
        <section class="sheet relation-panel">
          <header class="sheet-head" data-reveal>
            <h2 class="sheet-title">{{ relation.title }}</h2>
            <span class="sheet-meta">{{ relation.table.rows.length }}</span>
          </header>
          <div class="table-wrap">
            {{ table.render(relation.table, relation.empty) | safe }}
          </div>
        </section>
      {% endif %}
    {% endfor %}
  </div>
</div>
{% endblock %}

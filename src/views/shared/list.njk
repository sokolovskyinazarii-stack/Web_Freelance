{% extends "layout.njk" %}
{% import "macros/table.njk" as table %}
{% import "macros/ui.njk" as ui %}

{% block content %}
<div class="page">
  <aside class="rail">
    <p class="eyebrow">Розділ</p>
    <h1>{{ title }}</h1>
    <p class="lede">{{ searchHint }}</p>

    <div class="rail-actions">
      {% if canManage %}
        <a class="btn btn-primary" href="/{{ active }}/new">Створити</a>
      {% elif canCreateOrder %}
        <a class="btn btn-primary" href="/orders/request">Створити замовлення</a>
      {% endif %}
      <form class="search-form" method="get" action="" role="search">
        <label class="search">
          {{ ui.searchIcon() | safe }}
          <input type="search" name="q" value="{{ query }}" placeholder="{{ searchHint }}" autocomplete="off" aria-label="{{ searchHint }}">
        </label>
      </form>
    </div>

    <div class="rail-meta">
      <span>Записів: <b>{{ tableData.rows.length }}</b></span>
      <span>Рядок відкриває деталі</span>
    </div>
  </aside>

  <div class="column">
    {% if flash %}
      <div class="alert alert-{{ flash.type }}">{{ flash.text }}</div>
    {% endif %}

    <section class="sheet">
      <div class="table-wrap">
        {{ table.render(tableData) | safe }}
      </div>
    </section>
  </div>
</div>
{% endblock %}

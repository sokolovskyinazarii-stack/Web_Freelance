{% extends "layout.njk" %}
{% import "macros/table.njk" as table %}
{% import "macros/icons.njk" as icons %}

{% block content %}
<div class="page">
  <aside class="rail">
    <h1 data-reveal>{{ title }}</h1>

    <div class="rail-actions" data-reveal>
      {% if canManage %}
        <a class="btn btn-primary" href="/{{ active }}/new">
          {{ icons.icon('plus', 15) }}
          Створити
        </a>
      {% elif canCreateOrder %}
        <a class="btn btn-primary" href="/orders/request">
          {{ icons.icon('plus', 15) }}
          Нове замовлення
        </a>
      {% endif %}
      <form class="search-form" method="get" action="" role="search">
        <label class="search">
          {{ icons.icon('search', 15) }}
          <input type="search" name="q" value="{{ query }}" placeholder="{{ searchHint }}" autocomplete="off" aria-label="{{ searchHint }}">
        </label>
      </form>
    </div>

    <p class="rail-count">{{ tableData.rows.length }} {{ tableData.rows.length | plural('запис', 'записи', 'записів') }}</p>
  </aside>

  <div class="column">
    {% if flash %}
      <div class="alert alert-{{ flash.type }}" data-reveal>{{ flash.text }}</div>
    {% endif %}

    <section class="sheet">
      <div class="table-wrap">
        {{ table.render(tableData) | safe }}
      </div>
    </section>
  </div>
</div>
{% endblock %}

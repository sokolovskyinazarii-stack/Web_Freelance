{% extends "layout.njk" %}
{% import "macros/table.njk" as table %}
{% import "macros/ui.njk" as ui %}

{% block content %}
<section class="page-head">
  <h1>{{ title }}</h1>
  <form class="page-tools" method="get" action="">
    <label class="search">
      {{ ui.searchIcon() | safe }}
      <input type="search" name="q" value="{{ query }}" placeholder="{{ searchHint }}" autocomplete="off">
    </label>
  </form>
</section>

<section class="panel table-panel">
  <div class="table-wrap">
    {{ table.render(tableData) | safe }}
  </div>
</section>
{% endblock %}

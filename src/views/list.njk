{% extends "layout.njk" %}
{% import "macros/table.njk" as table %}
{% import "macros/ui.njk" as ui %}

{% block content %}
{% if flash %}
  <div class="alert alert-{{ flash.type }}">{{ flash.text }}</div>
{% endif %}

<section class="page-head">
  <h1>{{ title }}</h1>
  <div class="page-tools">
    {% if canManage %}
      <a class="btn btn-primary" href="/{{ active }}/new">Створити</a>
    {% endif %}
    <form class="search-form" method="get" action="">
      <label class="search">
        {{ ui.searchIcon() | safe }}
        <input type="search" name="q" value="{{ query }}" placeholder="{{ searchHint }}" autocomplete="off">
      </label>
    </form>
  </div>
</section>

<section class="panel table-panel">
  <div class="table-wrap">
    {{ table.render(tableData) | safe }}
  </div>
</section>
{% endblock %}

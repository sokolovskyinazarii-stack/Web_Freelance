{% extends "layout.njk" %}
{% import "macros/icons.njk" as icons %}

{% block content %}
<div class="page">
  <aside class="rail">
    <span class="avatar avatar-xl avatar-violet" data-reveal>{{ user.fullName | initials }}</span>
    <h1 data-reveal>{{ user.fullName }}</h1>
    <p class="lede" data-reveal>{{ user.email }}</p>
    <span class="badge" style="--tone:{{ user.role.color }}" data-reveal>{{ user.role.name }}</span>

    <div class="rail-actions rail-actions-stack" data-reveal>
      <a class="btn btn-ghost" href="/profile/edit">
        {{ icons.icon('edit', 15) }}
        Редагувати профіль
      </a>
    </div>
  </aside>

  <div class="column">
    {% if flash %}
      <div class="alert alert-{{ flash.type }}" data-reveal>{{ flash.text }}</div>
    {% endif %}

    <section class="metric-grid">
      {% for metric in metrics %}
        <article class="metric-card" data-reveal>
          <span class="metric-label">{{ metric.label }}</span>
          <strong>{{ metric.value }}</strong>
        </article>
      {% endfor %}
    </section>

    <section class="sheet">
      <header class="sheet-head" data-reveal>
        <h2 class="sheet-title">{{ icons.icon('users', 17) }} Акаунт</h2>
      </header>
      <dl class="field-grid">
        <div class="field">
          <dt>Email</dt>
          <dd>{{ user.email }}</dd>
        </div>
        <div class="field">
          <dt>Телефон</dt>
          <dd>{{ user.phone or '—' }}</dd>
        </div>
        <div class="field">
          <dt>Статус</dt>
          <dd>
            <span class="badge" style="--tone:{{ '#8fdfb4' if user.isActive else '#6e7568' }}">
              {{ 'Активний' if user.isActive else 'Заблокований' }}
            </span>
          </dd>
        </div>
        <div class="field">
          <dt>На платформі</dt>
          <dd>{{ user.createdAt | date }}</dd>
        </div>
      </dl>
    </section>

    {% if user.freelancer %}
      <section class="sheet">
        <header class="sheet-head" data-reveal>
          <h2 class="sheet-title">{{ icons.icon('freelancers', 17) }} Профіль фрілансера</h2>
        </header>
        <dl class="field-grid">
          <div class="field"><dt>Спеціальність</dt><dd>{{ user.freelancer.specialty }}</dd></div>
          <div class="field"><dt>Місто</dt><dd>{{ user.freelancer.city }}</dd></div>
          <div class="field"><dt>Ставка</dt><dd>{{ user.freelancer.hourlyRate | money }} / год</dd></div>
          <div class="field"><dt>Рейтинг</dt><dd>{{ user.freelancer.rating }}</dd></div>
          <div class="field field-wide"><dt>Про фахівця</dt><dd>{{ user.freelancer.bio or 'Опис ще не додано.' }}</dd></div>
        </dl>
      </section>
    {% elif user.customer %}
      <section class="sheet">
        <header class="sheet-head" data-reveal>
          <h2 class="sheet-title">{{ icons.icon('customers', 17) }} Профіль замовника</h2>
        </header>
        <dl class="field-grid">
          <div class="field"><dt>Компанія</dt><dd>{{ user.customer.companyName }}</dd></div>
          <div class="field"><dt>Контактна особа</dt><dd>{{ user.customer.contactName }}</dd></div>
          <div class="field"><dt>Місто</dt><dd>{{ user.customer.city }}</dd></div>
          <div class="field"><dt>Телефон</dt><dd>{{ user.customer.phone }}</dd></div>
        </dl>
      </section>
    {% elif user.courier %}
      <section class="sheet">
        <header class="sheet-head" data-reveal>
          <h2 class="sheet-title">{{ icons.icon('couriers', 17) }} Профіль кур’єра</h2>
        </header>
        <dl class="field-grid">
          <div class="field"><dt>Транспорт</dt><dd>{{ user.courier.vehicle }}</dd></div>
          <div class="field"><dt>Зона</dt><dd>{{ user.courier.zone }}</dd></div>
          <div class="field"><dt>Рейтинг</dt><dd>{{ user.courier.rating }}</dd></div>
          <div class="field"><dt>Статус</dt><dd>{{ 'На лінії' if user.courier.isActive else 'Поза зміною' }}</dd></div>
        </dl>
      </section>
    {% else %}
      <section class="sheet">
        <header class="sheet-head" data-reveal>
          <h2 class="sheet-title">{{ icons.icon('lock', 17) }} Доступ</h2>
        </header>
        <dl class="field-grid">
          <div class="field"><dt>Роль</dt><dd>{{ user.role.name }}</dd></div>
        </dl>
      </section>
    {% endif %}
  </div>
</div>
{% endblock %}

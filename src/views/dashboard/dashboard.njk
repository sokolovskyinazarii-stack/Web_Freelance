{% extends "layout.njk" %}
{% import "macros/table.njk" as table %}
{% import "macros/icons.njk" as icons %}

{% block content %}
<div class="page-full">
  <section class="page-head" data-reveal>
    <h1>Огляд</h1>
  </section>

  <section class="figures" aria-label="Ключові показники">
    {% for stat in stats %}
      <article class="figure" data-reveal>
        <div class="figure-head">
          <span class="figure-icon">{{ icons.icon(stat.icon or 'chart', 16) }}</span>
          <span class="figure-label">{{ stat.label }}</span>
        </div>
        <strong class="figure-value">{{ stat.value }}</strong>
        {% if stat.note %}<span class="figure-note">{{ stat.note }}</span>{% endif %}
      </article>
    {% endfor %}
  </section>

  <div class="split">
    <section class="sheet">
      <header class="sheet-head" data-reveal>
        <h2 class="sheet-title">{{ icons.icon('chart', 17) }} Замовлення за статусами</h2>
        <span class="sheet-meta">{{ totals.orders }} усього</span>
      </header>
      <div class="status-list">
        {% for status in statuses %}
          <div class="status-row" data-reveal>
            <div class="status-head">
              <span><i style="--tone:{{ status.color }}"></i>{{ status.name }}</span>
              <strong>{{ status.count }}</strong>
            </div>
            <div class="bar">
              <span style="width:{{ status.width }}%;background:{{ status.color }}"></span>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <section class="sheet">
      <header class="sheet-head" data-reveal>
        <h2 class="sheet-title">{{ icons.icon('freelancers', 17) }} Фрілансери</h2>
        <a class="link-arrow" href="/freelancers">Усі {{ icons.icon('arrow-up-right', 13) }}</a>
      </header>
      <div class="rank-list">
        {% for freelancer in freelancers %}
          <a class="rank-row" href="/freelancers/{{ freelancer.id }}" data-reveal>
            <span class="avatar avatar-violet">{{ freelancer.fullName | initials }}</span>
            <span class="rank-copy">
              <strong>{{ freelancer.fullName }}</strong>
              <small>{{ freelancer.specialty }}</small>
            </span>
            <span class="rank-meta">
              <span class="rating">{{ icons.icon('star', 12) }} {{ freelancer.rating }}</span>
              <small>{{ freelancer._count.orders }} {{ freelancer._count.orders | plural('замовлення', 'замовлення', 'замовлень') }}</small>
            </span>
          </a>
        {% endfor %}
      </div>
    </section>
  </div>

  <section class="sheet">
    <header class="sheet-head" data-reveal>
      <h2 class="sheet-title">{{ icons.icon('orders', 17) }} Останні замовлення</h2>
      <a class="link-arrow" href="/orders">Усі {{ icons.icon('arrow-up-right', 13) }}</a>
    </header>
    <div class="table-wrap">{{ table.render(recentTable) | safe }}</div>
  </section>

  <div class="split">
    <section class="sheet">
      <header class="sheet-head" data-reveal>
        <h2 class="sheet-title">{{ icons.icon('categories', 17) }} Категорії</h2>
        <a class="link-arrow" href="/categories">Усі {{ icons.icon('arrow-up-right', 13) }}</a>
      </header>
      <div class="category-list">
        {% for category in categories %}
          <a class="category-row" href="/categories/{{ category.id }}" data-reveal>
            <div class="category-head">
              <strong>{{ category.name }}</strong>
              <span>{{ category._count.projects }} {{ category._count.projects | plural('проєкт', 'проєкти', 'проєктів') }}</span>
            </div>
            <div class="bar"><span style="width:{{ category.width }}%"></span></div>
          </a>
        {% endfor %}
      </div>
    </section>

    <section class="sheet">
      <header class="sheet-head" data-reveal>
        <h2 class="sheet-title">{{ icons.icon('deliveries', 17) }} Доставки</h2>
        <a class="link-arrow" href="/deliveries">Усі {{ icons.icon('arrow-up-right', 13) }}</a>
      </header>
      <div class="logistics-grid">
        <div class="logistics-tile" data-reveal><span>Очікують</span><strong>{{ deliveryBreakdown.pending or 0 }}</strong></div>
        <div class="logistics-tile" data-reveal><span>У дорозі</span><strong>{{ deliveryBreakdown.in_transit or 0 }}</strong></div>
        <div class="logistics-tile" data-reveal><span>Доставлено</span><strong>{{ deliveryBreakdown.delivered or 0 }}</strong></div>
        <div class="logistics-tile" data-reveal><span>Кур’єри</span><strong>{{ totals.couriers }}</strong></div>
      </div>
    </section>
  </div>
</div>
{% endblock %}

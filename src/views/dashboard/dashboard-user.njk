{% extends "layout.njk" %}
{% import "macros/table.njk" as table %}
{% import "macros/icons.njk" as icons %}

{% block content %}
<div class="page-full">
  <section class="page-head" data-reveal>
    <h1>Огляд</h1>
    {% if dashboardNote %}<p class="page-lede">{{ dashboardNote }}</p>{% endif %}
  </section>

  <section class="sheet">
    <header class="sheet-head" data-reveal>
      <h2 class="sheet-title">{{ icons.icon('orders', 17) }} {{ tableTitle }}</h2>
      <a class="link-arrow" href="{{ tableHref }}">Усі {{ icons.icon('arrow-up-right', 13) }}</a>
    </header>
    <div class="table-wrap">{{ table.render(tableData) | safe }}</div>
  </section>
</div>
{% endblock %}

{% extends "layout.njk" %}
{% import "macros/table.njk" as table %}

{% block content %}
<div class="page-full">
  <section class="page-head">
    <p class="eyebrow">Особистий огляд{% if currentUser %} · {{ currentUser.role.name }}{% endif %}</p>
    <div class="page-head-row">
      <h1>Ваш <em>потік</em></h1>
      <p class="lede">Короткий зріз вашої роботи на платформі{% if currentUser %}, {{ currentUser.fullName }}{% endif %}. Дані оновлюються під час кожного запиту до PostgreSQL (Neon).</p>
    </div>
  </section>

  <section class="figures" aria-label="Ваші показники">
    {% for stat in stats %}
      <article class="figure">
        <span class="figure-label">{{ stat.label }}</span>
        <strong class="figure-value">{{ stat.value }}</strong>
        <span class="figure-note">{{ stat.note }}</span>
      </article>
    {% endfor %}
  </section>

  <section class="sheet">
    <header class="sheet-head">
      <h2 class="sheet-title"><i>01</i> {{ tableTitle }}</h2>
      <a class="link-arrow" href="{{ tableHref }}">Усі</a>
    </header>
    <div class="table-wrap">{{ table.render(tableData) | safe }}</div>
  </section>
</div>
{% endblock %}

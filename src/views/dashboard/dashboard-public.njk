{% extends "layout.njk" %}
{% import "macros/table.njk" as table %}
{% import "macros/icons.njk" as icons %}

{% block content %}
<div class="page-full">
  <section class="page-head" data-reveal>
    <h1>Платформа для фрілансу</h1>
    <p class="page-lede">Відкриті проєкти, виконавці та категорії. Для створення замовлення або подачі заявки потрібен акаунт.</p>
    <div class="page-actions">
      <a class="btn btn-primary" href="/projects">
        Переглянути проєкти
        {{ icons.icon('arrow-right', 15) }}
      </a>
      <a class="btn btn-ghost" href="/register">Зареєструватися</a>
    </div>
  </section>

  <section class="figures" aria-label="Показники платформи">
    {% for stat in stats %}
      <article class="figure" data-reveal>
        <div class="figure-head">
          <span class="figure-icon">{{ icons.icon(stat.icon or 'chart', 16) }}</span>
          <span class="figure-label">{{ stat.label }}</span>
        </div>
        <strong class="figure-value">{{ stat.value }}</strong>
        {% if stat.note %}<span class="figure-note">{{ stat.note }}</span>{% endif %}
      </article>
    {% endfor %}
  </section>

  <section class="sheet">
    <header class="sheet-head" data-reveal>
      <h2 class="sheet-title">{{ icons.icon('projects', 17) }} Останні проєкти</h2>
      <a class="link-arrow" href="/projects">Усі проєкти {{ icons.icon('arrow-up-right', 13) }}</a>
    </header>
    <div class="table-wrap">{{ table.render(recentTable) | safe }}</div>
  </section>
</div>
{% endblock %}

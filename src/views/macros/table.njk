{% import "macros/ui.njk" as ui %}

{% macro render(table, empty) %}
{% if table.rows.length %}
<table class="data-table">
  <thead>
    <tr>
      {% for column in table.columns %}
        <th class="{{ 'align-right' if column.align == 'right' else '' }}">{{ column.label }}</th>
      {% endfor %}
      {% if table.editable or table.deletable or table.password %}<th class="row-actions"></th>{% endif %}
    </tr>
  </thead>
  <tbody>
    {% for row in table.rows %}
      <tr tabindex="0" data-href="{{ row.href }}">
        {% for cell in row.cells %}
          <td class="{{ 'align-right' if cell.align == 'right' else '' }}">{{ ui.cell(cell) | safe }}</td>
        {% endfor %}
        {% if table.editable or table.deletable or table.password %}
          <td class="row-actions">
            <div class="row-actions-inner">
              {% if table.password %}
                <button class="row-password" type="button" title="Скинути пароль" aria-label="Скинути пароль"
                  data-password data-resource="{{ table.resource }}" data-id="{{ row.id }}"
                  data-user-name="{{ row.displayTitle }}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="7.5" cy="12" r="4"></circle>
                    <path d="M11.5 12H21M18 12v3M15 12v2"></path>
                  </svg>
                </button>
              {% endif %}
              {% if table.editable %}
                <a class="row-edit" href="{{ row.editHref }}" title="Редагувати" aria-label="Редагувати запис">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                  </svg>
                </a>
              {% endif %}
              {% if table.deletable %}
                <button class="row-delete" type="button" title="Видалити" aria-label="Видалити запис"
                  data-delete data-resource="{{ table.resource }}" data-id="{{ row.id }}" data-title="{{ row.deleteTitle }}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6h18"></path>
                    <path d="M8 6V4h8v2"></path>
                    <path d="M19 6l-1 14H6L5 6"></path>
                    <path d="M10 11v5M14 11v5"></path>
                  </svg>
                </button>
              {% endif %}
            </div>
          </td>
        {% endif %}
      </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<div class="empty-state">
  <strong>Нічого не знайдено</strong>
  <p>{{ empty or 'Спробуйте змінити пошуковий запит.' }}</p>
</div>
{% endif %}
{% endmacro %}

{% macro icon(name, size) %}
{%- set s = size or 18 -%}
<svg class="icon icon-{{ name }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none"
  stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {%- if name == 'overview' -%}
    <rect x="3" y="3" width="7" height="7" rx="1.4"/>
    <rect x="14" y="3" width="7" height="7" rx="1.4"/>
    <rect x="3" y="14" width="7" height="7" rx="1.4"/>
    <rect x="14" y="14" width="7" height="7" rx="1.4"/>
  {%- elif name == 'projects' -%}
    <rect x="2.5" y="7" width="19" height="13.5" rx="2"/>
    <path d="M8.5 7V5.5A2.5 2.5 0 0 1 11 3h2a2.5 2.5 0 0 1 2.5 2.5V7"/>
    <path d="M2.5 12.5h19"/>
  {%- elif name == 'freelancers' -%}
    <circle cx="12" cy="8" r="3.6"/>
    <path d="M4.5 21c0-3.6 3.4-5.6 7.5-5.6s7.5 2 7.5 5.6"/>
  {%- elif name == 'customers' -%}
    <path d="M4 21V5.5A1.5 1.5 0 0 1 5.5 4h7A1.5 1.5 0 0 1 14 5.5V21"/>
    <path d="M14 9h4.5A1.5 1.5 0 0 1 20 10.5V21"/>
    <path d="M2.5 21h19"/>
    <path d="M7 8h4M7 12h4M7 16h4M16.5 13h1M16.5 17h1"/>
  {%- elif name == 'categories' -%}
    <path d="M20.6 13.4 12 22 2 12V2h10l8.6 8.6a2 2 0 0 1 0 2.8Z"/>
    <circle cx="7" cy="7" r="1.3"/>
  {%- elif name == 'orders' -%}
    <path d="M6 2.5h9l4 4V21.5H6Z"/>
    <path d="M14.5 2.5v4.5H19"/>
    <path d="M9 12h6M9 16h4"/>
  {%- elif name == 'statuses' -%}
    <path d="M3 12h3.5l2.5 7 5-14 2.5 7H21"/>
  {%- elif name == 'deliveries' -%}
    <path d="M2.5 6.5h10v10h-10Z"/>
    <path d="M12.5 10h4l3 3v3.5h-7Z"/>
    <circle cx="6.5" cy="18" r="1.8"/>
    <circle cx="16.5" cy="18" r="1.8"/>
  {%- elif name == 'couriers' -%}
    <circle cx="12" cy="12" r="9"/>
    <path d="m15.5 8.5-2 5-5 2 2-5Z"/>
  {%- elif name == 'users' -%}
    <circle cx="9" cy="8" r="3.2"/>
    <path d="M2.5 20.5c0-3.2 3-5 6.5-5s6.5 1.8 6.5 5"/>
    <path d="M16 5.2a3.2 3.2 0 0 1 0 5.9M18 15.7c2 .7 3.5 2.2 3.5 4.8"/>
  {%- elif name == 'login' -%}
    <path d="M14.5 3H19a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4.5"/>
    <path d="m9 16 4-4-4-4M13 12H2.5"/>
  {%- elif name == 'logout' -%}
    <path d="M9.5 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4.5"/>
    <path d="m15 17 4-5-4-5M19 12H8.5"/>
  {%- elif name == 'search' -%}
    <circle cx="11" cy="11" r="7"/>
    <path d="m20.5 20.5-4-4"/>
  {%- elif name == 'plus' -%}
    <path d="M12 4.5v15M4.5 12h15"/>
  {%- elif name == 'edit' -%}
    <path d="M12 20.5h9"/>
    <path d="M16.6 3.4a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>
  {%- elif name == 'trash' -%}
    <path d="M3.5 6h17M9 6V3.8h6V6M18.5 6l-.9 14.2H6.4L5.5 6"/>
    <path d="M10 10.5v6M14 10.5v6"/>
  {%- elif name == 'key' -%}
    <circle cx="8" cy="15.5" r="4"/>
    <path d="m11 12.5 9.5-9.5M17 6.5l2.5 2.5M14 9.5l2.5 2.5"/>
  {%- elif name == 'copy' -%}
    <rect x="9" y="9" width="12" height="12" rx="2"/>
    <path d="M5.5 15H4a1.8 1.8 0 0 1-1.8-1.8V5.5A1.8 1.8 0 0 1 4 3.7h7.7A1.8 1.8 0 0 1 13.5 5.5V7"/>
  {%- elif name == 'check' -%}
    <path d="m5 12.5 4.5 4.5L19 6.5"/>
  {%- elif name == 'close' -%}
    <path d="m6 6 12 12M18 6 6 18"/>
  {%- elif name == 'chevron-down' -%}
    <path d="m6 9.5 6 6 6-6"/>
  {%- elif name == 'chevron-up' -%}
    <path d="m6 14.5 6-6 6 6"/>
  {%- elif name == 'arrow-right' -%}
    <path d="M4 12h15M14 7l5 5-5 5"/>
  {%- elif name == 'arrow-up-right' -%}
    <path d="M7 17 17 7M8.5 7H17v8.5"/>
  {%- elif name == 'star' -%}
    <path d="m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.5 9.7l5.9-.8Z"/>
  {%- elif name == 'calendar' -%}
    <rect x="3" y="5" width="18" height="16" rx="2"/>
    <path d="M16 3v4M8 3v4M3 10h18"/>
  {%- elif name == 'mail' -%}
    <rect x="2.5" y="4.5" width="19" height="15" rx="2"/>
    <path d="m3 7 9 6 9-6"/>
  {%- elif name == 'phone' -%}
    <path d="M8.3 3.5 5.6 4.4a2 2 0 0 0-1.3 2.3 17.5 17.5 0 0 0 13 12.7 2 2 0 0 0 2.3-1.3l.9-2.7-4.2-2-1.4 2a13.4 13.4 0 0 1-4.6-4.6l2-1.4Z"/>
  {%- elif name == 'pin' -%}
    <path d="M20.5 10.2c0 5.8-8.5 11.6-8.5 11.6S3.5 16 3.5 10.2a8.5 8.5 0 0 1 17 0Z"/>
    <circle cx="12" cy="10" r="3"/>
  {%- elif name == 'wallet' -%}
    <path d="M20.5 12.5V7.5H5a2.2 2.2 0 0 1 0-4.4h14v4.4"/>
    <path d="M3 7.5v11A2.5 2.5 0 0 0 5.5 21h15v-5"/>
    <path d="M17.5 12.5a2 2 0 0 0 0 4h5v-4Z"/>
  {%- elif name == 'clock' -%}
    <circle cx="12" cy="12" r="9"/>
    <path d="M12 7.5V12l3.2 2"/>
  {%- elif name == 'alert' -%}
    <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/>
    <path d="M12 9v4.5M12 17h.01"/>
  {%- elif name == 'box' -%}
    <path d="M21 8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.7Z"/>
    <path d="M3.3 7 12 12l8.7-5M12 22V12"/>
  {%- elif name == 'lock' -%}
    <rect x="3.5" y="10.5" width="17" height="10.5" rx="2"/>
    <path d="M7.5 10.5V7a4.5 4.5 0 0 1 9 0v3.5"/>
  {%- elif name == 'user-plus' -%}
    <circle cx="10" cy="8" r="3.4"/>
    <path d="M3.5 20.5c0-3.3 3-5.2 6.5-5.2s6.5 1.9 6.5 5.2"/>
    <path d="M19 5v6M16 8h6"/>
  {%- elif name == 'refresh' -%}
    <path d="M20.5 12a8.5 8.5 0 1 1-2.6-6.1"/>
    <path d="M20.5 3.5V9H15"/>
  {%- elif name == 'save' -%}
    <path d="M4 3.5h12.5L20.5 8v12.5H4Z"/>
    <path d="M8 3.5v5h7v-5M8 20.5v-6h8v6"/>
  {%- elif name == 'chart' -%}
    <path d="M4 20V4M4 20h16"/>
    <path d="M8 16v-4M12 16V8M16 16v-6M20 16v-2"/>
  {%- elif name == 'menu' -%}
    <path d="M4 7h16M4 12h16M4 17h16"/>
  {%- elif name == 'more' -%}
    <circle cx="5" cy="12" r="1.4" fill="currentColor" stroke="none"/>
    <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/>
    <circle cx="19" cy="12" r="1.4" fill="currentColor" stroke="none"/>
  {%- endif -%}
</svg>
{% endmacro %}

{% extends "layout.njk" %}
{% import "macros/icons.njk" as icons %}

{% block content %}
<div class="auth auth-wide">
  <div class="auth-main">
    <h1 class="auth-title" data-reveal>Реєстрація</h1>

    {% if errors._form %}
      <div class="alert alert-error">{{ errors._form }}</div>
    {% endif %}

    <form method="post" action="/register" novalidate class="entity-form auth-form auth-form-wide" data-reveal>
      <div class="form-grid">
        <div class="form-field form-field-wide">
          <label for="role">Роль</label>
          <select id="role" name="role" data-searchable data-placeholder="Оберіть роль">
            <option value="">Не вибрано</option>
            <option value="CLIENT"{% if values.role == 'CLIENT' %} selected{% endif %}>Замовник</option>
            <option value="FREELANCER"{% if values.role == 'FREELANCER' %} selected{% endif %}>Фрілансер</option>
          </select>
          {% if errors.role %}<p class="field-error">{{ errors.role }}</p>{% endif %}
        </div>

        <div class="form-field form-field-wide">
          <label for="fullName">ПІБ</label>
          <input id="fullName" type="text" name="fullName" value="{{ values.fullName }}" autocomplete="name" placeholder="Ім’я Прізвище">
          {% if errors.fullName %}<p class="field-error">{{ errors.fullName }}</p>{% endif %}
        </div>

        <div class="form-field">
          <label for="email">Email</label>
          <input id="email" type="email" name="email" value="{{ values.email }}" autocomplete="email" placeholder="name@example.com">
          {% if errors.email %}<p class="field-error">{{ errors.email }}</p>{% endif %}
        </div>

        <div class="form-field">
          <label for="phone">Телефон</label>
          <input id="phone" type="tel" name="phone" value="{{ values.phone }}" autocomplete="tel" placeholder="+380">
          {% if errors.phone %}<p class="field-error">{{ errors.phone }}</p>{% endif %}
        </div>

        <div class="form-field form-field-wide">
          <label for="city">Місто</label>
          <input id="city" type="text" name="city" value="{{ values.city }}" autocomplete="address-level2" placeholder="Київ">
          {% if errors.city %}<p class="field-error">{{ errors.city }}</p>{% endif %}
        </div>

        <div class="form-field">
          <label for="password">Пароль</label>
          <input id="password" type="password" name="password" autocomplete="new-password">
          {% if errors.password %}<p class="field-error">{{ errors.password }}</p>{% endif %}
        </div>

        <div class="form-field">
          <label for="passwordConfirm">Повторіть пароль</label>
          <input id="passwordConfirm" type="password" name="passwordConfirm" autocomplete="new-password">
          {% if errors.passwordConfirm %}<p class="field-error">{{ errors.passwordConfirm }}</p>{% endif %}
        </div>

        <p class="field-hint form-field-wide">Мінімум 12 символів, хоча б одна літера й одна цифра.</p>
      </div>

      <div class="form-actions">
        <button class="btn btn-primary" type="submit">
          Зареєструватися
          {{ icons.icon('arrow-right', 15) }}
        </button>
      </div>
    </form>

    <p class="auth-switch" data-reveal>Вже є акаунт? <a href="/login">Увійти</a></p>
  </div>

  <div class="auth-art" aria-hidden="true" data-reveal="scale">
    <div class="art-glow"></div>
    <svg class="art-svg" viewBox="0 0 400 400" fill="none">
      <circle class="art-ring art-ring-1" cx="200" cy="200" r="150" stroke="currentColor" stroke-width="1"/>
      <circle class="art-ring art-ring-2" cx="200" cy="200" r="112" stroke="currentColor" stroke-width="1"/>
      <circle class="art-ring art-ring-3" cx="200" cy="200" r="74" stroke="currentColor" stroke-width="1"/>
      <g class="art-orbit art-orbit-a" style="transform-origin:200px 200px">
        <circle cx="200" cy="50" r="5" fill="currentColor"/>
        <circle cx="200" cy="50" r="10" stroke="currentColor" stroke-width="1" opacity="0.35"/>
      </g>
      <g class="art-orbit art-orbit-b" style="transform-origin:200px 200px">
        <circle cx="88" cy="200" r="3.5" fill="currentColor"/>
        <circle cx="88" cy="200" r="8" stroke="currentColor" stroke-width="1" opacity="0.3"/>
      </g>
      <g class="art-orbit art-orbit-c" style="transform-origin:200px 200px">
        <rect x="296" y="196" width="8" height="8" transform="rotate(45 300 200)" fill="currentColor"/>
      </g>
      <circle class="art-core" cx="200" cy="200" r="4" fill="currentColor"/>
      <path class="art-scan" d="M50 200h300" stroke="currentColor" stroke-width="1"/>
    </svg>
  </div>
</div>
{% endblock %}

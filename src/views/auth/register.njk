{% extends "layout.njk" %}

{% block content %}
<section class="auth-wrap">
  <div class="panel form-panel">
    <section class="page-head">
      <h1>Реєстрація</h1>
    </section>

    {% if errors._form %}
      <div class="alert alert-error">{{ errors._form }}</div>
    {% endif %}

    <form method="post" action="/register" novalidate class="entity-form">
      <div class="form-grid">
        <div class="form-field form-field-wide">
          <label for="role">Роль</label>
          <select id="role" name="role" data-searchable data-placeholder="Оберіть роль">
            <option value="">Не вибрано</option>
            <option value="CLIENT"{% if values.role == 'CLIENT' %} selected{% endif %}>Замовник</option>
            <option value="FREELANCER"{% if values.role == 'FREELANCER' %} selected{% endif %}>Фрілансер</option>
          </select>
          {% if errors.role %}<p class="field-error">{{ errors.role }}</p>{% endif %}
        </div>

        <div class="form-field form-field-wide">
          <label for="fullName">ПІБ</label>
          <input id="fullName" type="text" name="fullName" value="{{ values.fullName }}" autocomplete="name">
          {% if errors.fullName %}<p class="field-error">{{ errors.fullName }}</p>{% endif %}
        </div>

        <div class="form-field">
          <label for="email">Email</label>
          <input id="email" type="email" name="email" value="{{ values.email }}" autocomplete="email">
          {% if errors.email %}<p class="field-error">{{ errors.email }}</p>{% endif %}
        </div>

        <div class="form-field">
          <label for="phone">Телефон</label>
          <input id="phone" type="tel" name="phone" value="{{ values.phone }}" autocomplete="tel">
          {% if errors.phone %}<p class="field-error">{{ errors.phone }}</p>{% endif %}
        </div>

        <div class="form-field form-field-wide">
          <label for="city">Місто</label>
          <input id="city" type="text" name="city" value="{{ values.city }}" autocomplete="address-level2">
          {% if errors.city %}<p class="field-error">{{ errors.city }}</p>{% endif %}
        </div>

        <div class="form-field">
          <label for="password">Пароль</label>
          <input id="password" type="password" name="password" autocomplete="new-password">
          {% if errors.password %}<p class="field-error">{{ errors.password }}</p>{% endif %}
        </div>

        <div class="form-field">
          <label for="passwordConfirm">Повторіть пароль</label>
          <input id="passwordConfirm" type="password" name="passwordConfirm" autocomplete="new-password">
          {% if errors.passwordConfirm %}<p class="field-error">{{ errors.passwordConfirm }}</p>{% endif %}
        </div>
      </div>

      <div class="form-actions">
        <a class="btn btn-ghost" href="/login">Увійти</a>
        <button class="btn btn-primary" type="submit">Зареєструватися</button>
      </div>
    </form>
  </div>
</section>
{% endblock %}

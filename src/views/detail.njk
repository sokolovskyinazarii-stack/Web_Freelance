{% extends "layout.njk" %}
{% import "macros/table.njk" as table %}
{% import "macros/ui.njk" as ui %}

{% block content %}
<nav class="crumbs">
  <a href="/{{ active }}">{{ label }}</a>
  <span>/</span>
  <span>{{ title }}</span>
</nav>

{% if flash %}
  <div class="alert alert-{{ flash.type }}">{{ flash.text }}</div>
{% endif %}

<section class="detail-hero accent-{{ accent }}">
  <div class="detail-identity">
    {{ ui.avatar(avatar) | safe }}
    <div>
      <h1>{{ title }}</h1>
      <p>{{ subtitle }}</p>
    </div>
  </div>
  <div class="detail-side">
    {{ ui.cell(badge) | safe }}
    <div class="detail-actions">
      <a class="btn btn-ghost" href="/{{ active }}/{{ id }}/edit">Редагувати</a>
      <button class="btn btn-danger" type="button" data-delete data-resource="{{ active }}" data-id="{{ id }}" data-title="{{ title }}">Видалити</button>
    </div>
  </div>
</section>

<section class="metric-grid">
  {% for metric in metrics %}
    <article class="metric-card">
      <span class="metric-label">{{ metric.label }}</span>
      <strong>{{ ui.cell(metric.cell) | safe }}</strong>
      {% if metric.hint %}<small>{{ metric.hint }}</small>{% endif %}
    </article>
  {% endfor %}
</section>

<section class="panel detail-panel">
  <header class="panel-head">
    <h3>Дані</h3>
  </header>
  <dl class="field-grid">
    {% for field in fields %}
      <div class="field{% if field.wide %} field-wide{% endif %}">
        <dt>{{ field.label }}</dt>
        <dd>{{ ui.cell(field.cell) | safe }}</dd>
      </div>
    {% endfor %}
  </dl>
</section>

{% for relation in relations %}
  <section class="panel relation-panel">
    <header class="panel-head">
      <h3>{{ relation.title }}</h3>
      <span>{{ relation.table.rows.length }}</span>
    </header>
    <div class="table-wrap">
      {{ table.render(relation.table, relation.empty) | safe }}
    </div>
  </section>
{% endfor %}
{% endblock %}

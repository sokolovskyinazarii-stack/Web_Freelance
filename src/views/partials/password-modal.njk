<div class="modal" id="password-modal" hidden>
  <div class="modal-backdrop" data-password-close></div>
  <div class="modal-dialog password-dialog" role="dialog" aria-modal="true" aria-labelledby="password-modal-title">
    <h3 id="password-modal-title">Скидання пароля</h3>
    <p class="password-modal-user" id="password-modal-user"></p>

    <form method="post" action="" id="password-form">
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" data-password-close>Скасувати</button>
        <button type="submit" class="btn btn-primary">Згенерувати новий пароль</button>
      </div>
    </form>

    <div id="password-result" hidden>
      <div class="password-reveal">
        <code id="password-value"></code>
        <button class="btn btn-ghost" type="button" data-copy="#password-value">Скопіювати</button>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-primary" data-password-close>Готово</button>
      </div>
    </div>
  </div>
</div>

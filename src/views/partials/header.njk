{% import "macros/icons.njk" as icons %}
<header class="masthead">
  <a class="wordmark" href="/" aria-label="FreelanceHub — на головну">
    <span class="wordmark-mark" aria-hidden="true">
      <svg viewBox="0 0 32 32" fill="none">
        <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.8"/>
        <circle cx="16" cy="16" r="3" fill="currentColor"/>
        <path d="M16 1.5v5M16 25.5v5M1.5 16h5M25.5 16h5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
      </svg>
    </span>
    <span class="wordmark-text">Freelance<i>Hub</i></span>
  </a>

  <nav class="masthead-nav" id="nav" aria-label="Головна навігація">
    {% for item in navItems %}
      {% if not item.secondary %}
        <a class="nav-link{% if active == item.key %} active{% endif %}" href="{{ item.href }}"{% if active == item.key %} aria-current="page"{% endif %}>
          <span class="nav-icon">{{ icons.icon(item.icon, 15) }}</span>
          <span class="nav-label">{{ item.label }}</span>
        </a>
      {% endif %}
    {% endfor %}

    {% if currentRole == 'ADMIN' %}
      <details class="nav-more" id="nav-more">
        <summary class="nav-link nav-more-toggle{% if active in ['customers', 'statuses', 'couriers', 'users'] %} active{% endif %}">
          <span class="nav-icon">{{ icons.icon('more', 15) }}</span>
          <span class="nav-label">Ще</span>
          {{ icons.icon('chevron-down', 12) }}
        </summary>
        <div class="nav-more-menu">
          {% for item in navItems %}
            {% if item.secondary %}
              <a class="nav-more-link{% if active == item.key %} active{% endif %}" href="{{ item.href }}"{% if active == item.key %} aria-current="page"{% endif %}>
                {{ icons.icon(item.icon, 16) }}
                <span>{{ item.label }}</span>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </details>
    {% endif %}
  </nav>

  {% if currentUser %}
    <div class="account-nav">
      <a class="account-chip{% if active == 'profile' %} active{% endif %}" href="/profile" title="Профіль">
        <span class="avatar avatar-violet">{{ currentUser.fullName | initials }}</span>
        <span class="account-copy">
          <span class="account-name">{{ currentUser.fullName }}</span>
          <span class="account-role">{{ currentUser.role.name }}</span>
        </span>
      </a>

      <form method="post" action="/logout" class="logout-form">
        <button class="icon-button" type="submit" aria-label="Вийти" title="Вийти">
          {{ icons.icon('logout', 16) }}
        </button>
      </form>
    </div>
  {% endif %}

  <button class="menu-toggle" id="menu-toggle" aria-label="Меню" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</header>

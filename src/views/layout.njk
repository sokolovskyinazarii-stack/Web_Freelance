{% import "macros/icons.njk" as icons %}
<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} · FreelanceHub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <meta name="theme-color" content="#090b08">
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script src="/js/core/boot.js"></script>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
  {% include "partials/header.njk" %}

  <main class="shell">
    <div class="view" id="view">
      {% block content %}{% endblock %}
    </div>

    <footer class="footer">
      <span class="footer-brand">© 2026 FreelanceHub</span>
      <nav class="footer-links" aria-label="Розділи">
        <a href="/projects">Проєкти</a>
        <a href="/freelancers">Фрілансери</a>
        <a href="/categories">Категорії</a>
      </nav>
      <button class="footer-top" type="button" data-scroll-top>
        Догори
        {{ icons.icon('chevron-up', 14) }}
      </button>
    </footer>
  </main>

  {% include "partials/delete-modal.njk" %}
  {% if currentUser and currentRole == 'ADMIN' %}
    {% include "partials/password-modal.njk" %}
  {% endif %}

  <script src="/js/core/ui.js"></script>
  <script src="/js/core/reveal.js"></script>
  <script src="/js/ui/copy.js"></script>
  <script src="/js/ui/select.js"></script>
  <script src="/js/ui/stepper.js"></script>
  <script src="/js/ui/date.js"></script>
  <script src="/js/ui/modal.js"></script>
  <script src="/js/ui/password-modal.js"></script>
  <script src="/js/core/ajax.js"></script>
</body>
</html>

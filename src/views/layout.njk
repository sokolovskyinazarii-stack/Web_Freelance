<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} · FreelanceHub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  {% include "partials/header.njk" %}

  <main class="main">
    <div class="view" id="view">
      {% block content %}{% endblock %}
    </div>
  </main>

  {% include "partials/delete-modal.njk" %}
  {% if currentUser and currentRole == 'ADMIN' %}
    {% include "partials/password-modal.njk" %}
  {% endif %}

  <script src="/js/core/ui.js"></script>
  <script src="/js/ui/copy.js"></script>
  <script src="/js/ui/select.js"></script>
  <script src="/js/ui/stepper.js"></script>
  <script src="/js/ui/modal.js"></script>
  <script src="/js/ui/password-modal.js"></script>
  <script src="/js/core/ajax.js"></script>
</body>
</html>

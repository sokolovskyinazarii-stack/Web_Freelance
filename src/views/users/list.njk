{% extends "layout.njk" %}
{% import "macros/icons.njk" as icons %}

{% block content %}
<div class="page">
  <aside class="rail">
    <h1 data-reveal>Користувачі</h1>

    <div class="rail-actions" data-reveal>
      <a class="btn btn-primary" href="/users/new">
        {{ icons.icon('user-plus', 15) }}
        Створити
      </a>
    </div>
  </aside>

  <div class="column">
    <section class="sheet">
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Користувач</th>
              <th>Роль</th>
              <th>Профіль</th>
              <th>Статус</th>
              <th class="row-actions"></th>
            </tr>
          </thead>
          <tbody>
            {% for user in users %}
              <tr data-reveal>
                <td>
                  <div class="person">
                    <span class="avatar avatar-violet">{{ user.fullName | initials }}</span>
                    <span class="person-text">
                      <strong>{{ user.fullName }}</strong>
                      <small>{{ user.email }}</small>
                    </span>
                  </div>
                </td>
                <td>
                  <span class="badge" style="--tone:{{ user.role.color }}">{{ user.role.name }}</span>
                </td>
                <td>
                  {% if user.freelancer %}
                    Фрілансер: {{ user.freelancer.fullName }}
                  {% elif user.customer %}
                    Замовник: {{ user.customer.companyName }}
                  {% elif user.courier %}
                    Кур’єр: {{ user.courier.fullName }}
                  {% else %}
                    —
                  {% endif %}
                </td>
                <td>
                  <span class="badge" style="--tone:{{ '#8fdfb4' if user.isActive else '#6e7568' }}">
                    {{ 'Активний' if user.isActive else 'Заблокований' }}
                  </span>
                </td>
                <td class="row-actions">
                  <div class="user-actions">
                    <button class="link-button" type="button" data-password data-resource="users" data-id="{{ user.id }}" data-user-name="{{ user.fullName }}">
                      {{ icons.icon('key', 13) }}
                      Пароль
                    </button>
                    <a class="link-button" href="/users/{{ user.id }}/edit">
                      {{ icons.icon('edit', 13) }}
                      Редагувати
                    </a>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>
{% endblock %}

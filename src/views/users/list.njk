{% extends "layout.njk" %}

{% block content %}
<div class="page">
  <aside class="rail">
    <p class="eyebrow">Адміністрування</p>
    <h1>Користувачі</h1>
    <p class="lede">Акаунти, ролі та доступ. Пароль генерується на сервері й показується один раз.</p>

    <div class="rail-actions">
      <a class="btn btn-primary" href="/users/new">Створити</a>
    </div>

    <div class="rail-meta">
      <span>Акаунтів: <b>{{ users.length }}</b></span>
      <span>Адмін · повний доступ</span>
    </div>
  </aside>

  <div class="column">
    <section class="sheet">
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Користувач</th>
              <th>Роль</th>
              <th>Профіль</th>
              <th>Статус</th>
              <th class="row-actions"></th>
            </tr>
          </thead>
          <tbody>
            {% for user in users %}
              <tr>
                <td>
                  <div class="person">
                    <span class="avatar avatar-violet">{{ user.fullName | initials }}</span>
                    <span class="person-text">
                      <strong>{{ user.fullName }}</strong>
                      <small>{{ user.email }}</small>
                    </span>
                  </div>
                </td>
                <td>
                  <span class="badge" style="--tone:{{ user.role.color }}">{{ user.role.name }}</span>
                </td>
                <td>
                  {% if user.freelancer %}
                    Фрілансер: {{ user.freelancer.fullName }}
                  {% elif user.customer %}
                    Замовник: {{ user.customer.companyName }}
                  {% elif user.courier %}
                    Кур’єр: {{ user.courier.fullName }}
                  {% else %}
                    —
                  {% endif %}
                </td>
                <td>
                  <span class="badge" style="--tone:{{ '#8fdfb4' if user.isActive else '#6e7568' }}">
                    {{ 'Активний' if user.isActive else 'Заблокований' }}
                  </span>
                </td>
                <td class="row-actions">
                  <div class="user-actions">
                    <button class="link-button" type="button" data-password data-resource="users" data-id="{{ user.id }}" data-user-name="{{ user.fullName }}">Пароль</button>
                    <a class="link-arrow" href="/users/{{ user.id }}/edit">Редагувати</a>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>
{% endblock %}

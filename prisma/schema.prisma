generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  code  String @unique
  name  String
  color String
  users User[]
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  isActive     Boolean    @default(true)
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id])
  freelancer   Freelancer?
  customer     Customer?
  courier      Courier?
  reviews      Review[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Freelancer {
  id           Int           @id @default(autoincrement())
  fullName     String
  email        String        @unique
  phone        String
  specialty    String
  city         String
  hourlyRate   Float
  rating       Float         @default(0)
  bio          String?
  createdAt    DateTime      @default(now())
  userId       Int?          @unique
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  projects     Project[]
  orders       Order[]
  applications Application[]
}

model Customer {
  id          Int       @id @default(autoincrement())
  companyName String
  contactName String
  email       String    @unique
  phone       String
  city        String
  createdAt   DateTime  @default(now())
  userId      Int?      @unique
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  projects    Project[]
  orders      Order[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String
  createdAt   DateTime  @default(now())
  projects    Project[]
  orders      Order[]
}

model Project {
  id           Int        @id @default(autoincrement())
  title        String
  description  String
  budget       Float
  deadline     DateTime
  categoryId   Int
  customerId   Int
  freelancerId Int
  createdAt    DateTime   @default(now())
  category     Category   @relation(fields: [categoryId], references: [id])
  customer     Customer   @relation(fields: [customerId], references: [id])
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id])
  orders       Order[]
}

model Order {
  id             Int           @id @default(autoincrement())
  orderNumber    String        @unique
  title          String?
  description    String?
  amount         Float
  currency       String        @default("USD")
  deadline       DateTime?
  deliveryNeeded Boolean       @default(false)
  rejectionReason String?
  projectId      Int?
  categoryId     Int?
  customerId     Int
  freelancerId   Int?
  statusId       Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  project        Project?      @relation(fields: [projectId], references: [id])
  category       Category?     @relation(fields: [categoryId], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id])
  freelancer     Freelancer?   @relation(fields: [freelancerId], references: [id])
  status         Status        @relation(fields: [statusId], references: [id])
  delivery       Delivery?
  applications   Application[]
  reviews        Review[]
}

model Status {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  color       String
  description String
  sortOrder   Int      @default(0)
  orders      Order[]
}

model Courier {
  id         Int        @id @default(autoincrement())
  fullName   String
  phone      String     @unique
  email      String     @unique
  vehicle    String
  zone       String
  rating     Float      @default(0)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  userId     Int?       @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries Delivery[]
}

model Delivery {
  id             Int       @id @default(autoincrement())
  trackingNumber String    @unique
  address        String
  city           String
  status         String    @default("pending")
  cost           Float
  estimatedAt    DateTime
  deliveredAt    DateTime?
  orderId        Int       @unique
  courierId      Int?
  createdAt      DateTime  @default(now())
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier        Courier?  @relation(fields: [courierId], references: [id])
  reviews        Review[]
}

model Application {
  id             Int        @id @default(autoincrement())
  orderId        Int
  freelancerId   Int
  message        String?
  proposedAmount Float?
  status         String     @default("pending")
  createdAt      DateTime   @default(now())
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  freelancer     Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  @@unique([orderId, freelancerId])
}

model Review {
  id         Int       @id @default(autoincrement())
  orderId    Int?
  deliveryId Int?
  authorId   Int
  rating     Int
  comment    String?
  createdAt  DateTime  @default(now())
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@unique([orderId, authorId])
  @@unique([deliveryId, authorId])
}

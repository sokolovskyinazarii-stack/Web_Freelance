generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Freelancer {
  id         Int       @id @default(autoincrement())
  fullName   String
  email      String    @unique
  phone      String
  specialty  String
  city       String
  hourlyRate Float
  rating     Float     @default(0)
  bio        String?
  createdAt  DateTime  @default(now())
  projects   Project[]
  orders     Order[]
}

model Customer {
  id          Int       @id @default(autoincrement())
  companyName String
  contactName String
  email       String    @unique
  phone       String
  city        String
  createdAt   DateTime  @default(now())
  projects    Project[]
  orders      Order[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String
  createdAt   DateTime  @default(now())
  projects    Project[]
}

model Project {
  id           Int       @id @default(autoincrement())
  title        String
  description  String
  budget       Float
  deadline     DateTime
  categoryId   Int
  customerId   Int
  freelancerId Int
  createdAt    DateTime  @default(now())
  category     Category  @relation(fields: [categoryId], references: [id])
  customer     Customer  @relation(fields: [customerId], references: [id])
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id])
  orders       Order[]

  @@index([categoryId])
  @@index([customerId])
  @@index([freelancerId])
}

model Order {
  id           Int       @id @default(autoincrement())
  orderNumber  String    @unique
  amount       Float
  currency     String    @default("USD")
  projectId    Int
  customerId   Int
  freelancerId Int
  statusId     Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  project      Project   @relation(fields: [projectId], references: [id])
  customer     Customer  @relation(fields: [customerId], references: [id])
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id])
  status       Status    @relation(fields: [statusId], references: [id])
  delivery     Delivery?

  @@index([projectId])
  @@index([customerId])
  @@index([freelancerId])
  @@index([statusId])
}

model Status {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  color       String
  description String
  sortOrder   Int      @default(0)
  orders      Order[]
}

model Courier {
  id         Int        @id @default(autoincrement())
  fullName   String
  phone      String     @unique
  email      String     @unique
  vehicle    String
  zone       String
  rating     Float      @default(0)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  deliveries Delivery[]
}

model Delivery {
  id             Int       @id @default(autoincrement())
  trackingNumber String    @unique
  address        String
  city           String
  status         String    @default("pending")
  cost           Float
  estimatedAt    DateTime
  deliveredAt    DateTime?
  orderId        Int       @unique
  courierId      Int
  createdAt      DateTime  @default(now())
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier        Courier   @relation(fields: [courierId], references: [id])

  @@index([courierId])
}
